from collections import deque
start = (1, 2, 3, 4, 0, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)
q = deque([(start, [])])
visited = {start}
while q:
    state, path = q.popleft()
    if state == goal:
        print("Solution:")
        for s in path + [state]:
            for i in range(0, 9, 3):
                print(s[i:i+3])
            print()
        break

    z = state.index(0)
    moves = [-3, 3, -1, 1]

    for move in moves:
        n = z + move

        if not 0 <= n < 9:
            continue
        if move == -1 and z % 3 == 0:
            continue
        if move == 1 and z % 3 == 2:
            continue

        new = list(state)
        new[z], new[n] = new[n], new[z]
        new = tuple(new)

        if new not in visited:
            visited.add(new)
            q.append((new, path + [state]))
else:
    print("No solution found.")
